# --- AI provider ---
# The AI never decides the risk level (src/services/risk_engine.py does); it only
# explains the rule-based result and drafts the notification text.
# openai | azure_openai | gemini
AI_PROVIDER=openai

# --- OpenAI ---
# Required. Chosen per environment for cost/quality; must support structured
# outputs (json_schema, strict). Example: gpt-5-mini
OPENAI_MODEL=
# API key — NEVER commit a real value. Pick ONE:
#   a) AWS Secrets Manager (recommended; required for production): the secret
#      name or ARN. Read at runtime with the instance/task IAM role, cached for
#      SECRET_CACHE_TTL_SECONDS, re-read after a 401 so rotation needs no restart.
OPENAI_API_KEY_SECRET_ID=
#   b) Environment variable (local development, or injected by ECS `secrets:`).
OPENAI_API_KEY=
# Dedicated OpenAI project for this platform (optional with a project-scoped key).
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=
# Blank = api.openai.com
OPENAI_BASE_URL=
# Optional tuning. Blank = not sent (model default). Several current models
# reject a non-default temperature. reasoning_effort: minimal | low | medium | high
OPENAI_TEMPERATURE=
OPENAI_REASONING_EFFORT=

# --- Azure OpenAI (AI_PROVIDER=azure_openai) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY_SECRET_ID=
AZURE_OPENAI_API_KEY=

# --- Google Gemini (AI_PROVIDER=gemini; pip install google-generativeai) ---
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY_SECRET_ID=
GEMINI_API_KEY=

# --- AI call limits (all providers) ---
# Per-attempt timeout, total attempts (only transient errors are retried; hard
# cap 5), and the output token ceiling (reasoning tokens count against it).
AI_TIMEOUT_SECONDS=60
AI_MAX_ATTEMPTS=3
AI_MAX_OUTPUT_TOKENS=16000

# --- AWS ---
# Region for Secrets Manager (blank = AWS_DEFAULT_REGION / the ARN's region).
AWS_REGION=
# Optional JSON secret holding the platform credentials, overlaid at startup:
# {"ESET_WEBHOOK_AUTH_TOKEN": "...", "DASHBOARD_ACCESS_KEY": "...",
#  "EMAIL_API_KEY": "...", "EMAIL_API_SECRET": "...",
#  "VIRUSTOTAL_API_KEY": "...", "ABUSEIPDB_API_KEY": "..."}
APP_SECRETS_SECRET_ID=
SECRET_CACHE_TTL_SECONDS=300

# --- Webhook Auth ---
# The secret token ESET will send in the Authorization header (we define this).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# APP_ENV=production refuses to start with anything under 16 characters.
ESET_WEBHOOK_AUTH_TOKEN=change-me

# --- App ---
# development | production. production refuses to start on an unsafe config
# (blank/short DASHBOARD_ACCESS_KEY, placeholder webhook token, API docs on,
# email delivery on without credentials). The Docker image defaults to production.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
OUTPUT_DIR=output/alerts
# Structured JSON log read by the dashboard's Logs view; rotated by size.
LOG_FILE=logs/app.log
LOG_MAX_BYTES=20000000
LOG_BACKUP_COUNT=5
# true = also log the dashboard's own polling (successful GETs of the dashboard
# API, static files, /health). Off keeps the log readable; ingest requests and
# every error response are logged either way.
LOG_DASHBOARD_ACCESS=false
# Reverse proxies trusted to set X-Forwarded-For / X-Forwarded-Proto. "*" on a
# PaaS (Railway/Render/Fly) where only the platform edge can reach the app.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Auth throttling ---
# Wrong webhook tokens / dashboard keys per client address per window before
# that address gets HTTP 429. A request with no credential is not counted.
# 0 disables.
AUTH_MAX_FAILURES=20
AUTH_FAILURE_WINDOW_SECONDS=600

# --- Syslog Server ---
SYSLOG_HOST=0.0.0.0
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=601
# Comma-separated source IPs (or CIDRs) allowed to feed the syslog listeners.
# These listeners are unauthenticated by protocol, and the forwarder attaches the
# real ESET_WEBHOOK_AUTH_TOKEN on their behalf — so with this blank, anyone who
# can reach the ports can inject an authenticated alert, and every injected alert
# costs one AI generation and one round of outbound notifications. Blank =
# accept from anywhere, which is only safe when the ports are already behind a
# network boundary. In production set it to the ESET PROTECT exporter's address.
SYSLOG_ALLOWED_SOURCES=
# Bounds on what one sender can make the listeners do. Frames go to a fixed
# worker pool through a bounded queue; when the queue is full they are dropped and
# counted rather than queued, so a flood cannot grow the event loop until the API
# process (which hosts these listeners) falls over with it.
SYSLOG_QUEUE_SIZE=500
SYSLOG_WORKERS=4
SYSLOG_MAX_TCP_CONNECTIONS=50
SYSLOG_TCP_IDLE_TIMEOUT_SECONDS=60
SYSLOG_MAX_FRAME_BYTES=65536

# --- Database ---
SQLITE_DB_PATH=data/soc_lite.db

# --- Deduplication ---
DEDUP_TTL_SECONDS=300   # 5 minutes — identical alerts inside this window are dropped as duplicates

# --- Pipeline Limits ---
# Per-process cap across webhook, syslog, dashboard retry and startup recovery.
# Full capacity returns HTTP 503 + Retry-After before job/dedup persistence;
# senders should retry. Startup recovery waits for a free slot.
MAX_CONCURRENT_PIPELINES=4
THREAT_INTEL_TIMEOUT_SECONDS=5
# Simulated VirusTotal/AbuseIPDB verdicts. While true they are shown on the
# dashboard but NOT used for risk and NOT given to the AI. Set false (with
# VIRUSTOTAL_API_KEY / ABUSEIPDB_API_KEY) for real lookups.
USE_MOCK_THREAT_INTEL=true

# --- Rule-based risk assessment (src/services/risk_engine.py) ---
# Unhandled detections on these endpoint types / name patterns are raised one level.
IMPORTANT_ENDPOINT_TYPES=server,domain controller
# Comma-separated globs, e.g. MAC-FS-*,*-SQL*,DC-*
IMPORTANT_ENDPOINT_PATTERNS=
# Same detection on this many distinct endpoints within the window => CRITICAL.
OUTBREAK_ENDPOINT_THRESHOLD=3
OUTBREAK_WINDOW_SECONDS=3600

# --- AI Data Minimization ---
# Masks fields judged unnecessary for AI reasoning (see docs/SOC_LITE_AUDIT.md §9)
# before they reach the AI provider. Field policy is an engineering proposal pending client
# sign-off; the toggle exists so it can be disabled without a code change.
AI_MASKING_ENABLED=true

# --- Ingest Limits ---
# Defense-in-depth cap on inbound webhook body size, in bytes (default 1 MiB).
MAX_INGEST_BODY_BYTES=1048576

# --- Email Outbox Recipients (comma-separated addresses; blank = skip that notification type) ---
CLIENT_NOTIFICATION_EMAILS=
CTHREE_NOTIFICATION_EMAILS=
INTERNAL_NOTIFICATION_EMAILS=
ENGINEER_NOTIFICATION_EMAILS=

# --- Dashboard ---
# Gates every read/write API route, the WebSocket, and GET /status/{correlation_id}.
# Leave blank ONLY for a trusted local bind: blank means anyone who can reach the
# port can read alert data, recipients and AI traces. Set it before exposing this
# service on any network interface. At least 16 random characters (required
# when APP_ENV=production).
DASHBOARD_ACCESS_KEY=

# --- API Documentation ---
# /docs, /redoc and /openapi.json are served by FastAPI itself, so
# DASHBOARD_ACCESS_KEY cannot gate them. Off by default: left on they publish
# the full route inventory, ingest paths included, to any unauthenticated
# caller. Enable for local development only.
ENABLE_API_DOCS=false

# --- Email Delivery ---
# The mail service owns the send queue and its retries; this platform only hands
# each composed email over once (HTTP 202 = accepted).
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=eset_mail
EMAIL_API_URL=https://your-worker.workers.dev/api/send
EMAIL_API_KEY=
EMAIL_API_SECRET=
# Must match the worker's SECURITY_MODE: full | signed | api-key-only
EMAIL_SECURITY_MODE=full
EMAIL_TIMEOUT_SECONDS=15
# Handoff attempts before giving up (not delivery retries — the service does those)
EMAIL_MAX_ATTEMPTS=3
EMAIL_DISPATCH_INTERVAL_SECONDS=60

# --- Email Sender Routing (optional) ---
# The mail service can hold several configured senders (SMTP/Resend/SendGrid/
# Mailgun/Postmark) and fails over between them by priority. Leave all three
# blank to let it apply its own default/priority order — the right choice unless
# this platform must send from one specific verified address.
#
# Anything set here must exist and be ACTIVE on the mail service, or every send
# is rejected with 400 "Unauthorized Sender/Provider" (a permanent failure).
EMAIL_SENDER_EMAIL=
EMAIL_SENDER_NAME=
EMAIL_PROVIDER_ID=
# How the sender choice reaches the mail service:
#   false - in the signed JSON body (from_email / from_name / provider_id)
#   true  - as X-Sender-Email / X-Provider-Id headers, which the mail service
#           binds into the HMAC canonical string
# Both are tamper-proof; the body form is the simpler contract.
EMAIL_ROUTING_VIA_HEADERS=false
