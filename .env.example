# --- AI ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Webhook Auth ---
# The secret token ESET will send in the Authorization header (we define this)
ESET_WEBHOOK_AUTH_TOKEN=test

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
OUTPUT_DIR=output/alerts

# --- Syslog Server ---
SYSLOG_HOST=0.0.0.0
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=601

# --- Database ---
SQLITE_DB_PATH=data/soc_lite.db

# --- Deduplication ---
DEDUP_TTL_SECONDS=3600   # 1 hour

# --- Pipeline Limits ---
THREAT_INTEL_TIMEOUT_SECONDS=5
AI_TIMEOUT_SECONDS=30
MAX_RETRIES=3
